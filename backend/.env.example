# Distributor-RAG backend environment template
# Copy this file to backend/.env before configuring the backend:
#   cp backend/.env.example backend/.env
# Never commit backend/.env because it may contain API keys.
# All relative paths below are resolved from the backend directory.

# Application
APP_NAME=Excel RAG JSON Pipeline
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Storage
DATA_DIR=./data
STORAGE_DIR=./storage/original
MAX_UPLOAD_MB=30
FULL_SCAN_MAX_CHUNKS=200

# Embedding
# Keep mock mode enabled for a local demo without an API key.
# Set EMBEDDING_MOCK=false only after filling in the endpoint, key, and model.
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_BASE_URL=https://api.example.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_MOCK=true
EMBEDDING_DIM=384

# LLM
# Keep mock mode enabled for a local demo without an API key.
# Set LLM_MOCK=false only after filling in the endpoint, key, and model.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MOCK=true

# Retrieval defaults
DEFAULT_TOP_K=5
DEFAULT_CHUNK_SIZE=1200
DEFAULT_OVERLAP=100
DEFAULT_SCORE_THRESHOLD=0.2
DEFAULT_PERMISSION_LEVEL=1
