# ============================================
# Distributor-RAG 后端环境变量示例
# ============================================
# 使用方式（macOS / Linux）：
#   cp backend/.env.example backend/.env
# 使用方式（Windows CMD）：
#   copy backend\.env.example backend\.env
#
# 安全说明：backend/.env 可能包含 API Key，禁止提交到 Git。
# 路径说明：下面的相对路径均以 backend 目录为基准。
# 修改说明：修改配置后需要重启后端服务。

# ──────────────────────────────────────────────
# 一、应用基础配置
# ──────────────────────────────────────────────
# 应用名称
APP_NAME=Excel RAG JSON Pipeline
# 应用运行环境：development / production
APP_ENV=development
# 后端监听地址；0.0.0.0 允许局域网访问，仅本机使用可改为 127.0.0.1
BACKEND_HOST=0.0.0.0
# 后端服务端口
BACKEND_PORT=8000

# ──────────────────────────────────────────────
# 二、数据与文件存储配置
# ──────────────────────────────────────────────
# JSON 数据目录，启动时会自动创建
DATA_DIR=./data
# 上传原始文件目录，启动时会自动创建
STORAGE_DIR=./storage/original
# 单个文件最大上传大小，单位：MB
MAX_UPLOAD_MB=30
# 允许进行全量扫描的最大分块数量
FULL_SCAN_MAX_CHUNKS=200

# ──────────────────────────────────────────────
# 三、Embedding 向量模型配置
# ──────────────────────────────────────────────
# 服务类型，默认兼容 OpenAI Embeddings 接口
EMBEDDING_PROVIDER=openai-compatible
# Embedding 服务地址，通常以 /v1 结尾
EMBEDDING_BASE_URL=https://api.example.com/v1
# Embedding API Key；Mock 模式下可留空
EMBEDDING_API_KEY=
# Embedding 模型名称
EMBEDDING_MODEL=text-embedding-3-small
# 是否使用本地 Mock 向量：true=无需 API，false=调用真实服务
EMBEDDING_MOCK=true
# 向量维度；使用真实模型时应与模型返回维度一致
EMBEDDING_DIM=384

# ──────────────────────────────────────────────
# 四、LLM 对话模型配置
# ──────────────────────────────────────────────
# 服务类型，默认兼容 OpenAI Chat Completions 接口
LLM_PROVIDER=openai-compatible
# LLM 服务地址，通常以 /v1 结尾
LLM_BASE_URL=https://api.example.com/v1
# LLM API Key；Mock 模式下可留空
LLM_API_KEY=
# 对话模型名称
LLM_MODEL=gpt-4o-mini
# 是否使用本地 Mock 回答：true=无需 API，false=调用真实服务
LLM_MOCK=true

# ──────────────────────────────────────────────
# 五、RAG 检索与分块参数
# ──────────────────────────────────────────────
# 默认返回的相关文档数量
DEFAULT_TOP_K=5
# 文档分块大小，单位：字符数
DEFAULT_CHUNK_SIZE=1200
# 相邻文档分块之间的重叠大小，单位：字符数
DEFAULT_OVERLAP=100
# 检索结果相似度阈值
DEFAULT_SCORE_THRESHOLD=0.2
